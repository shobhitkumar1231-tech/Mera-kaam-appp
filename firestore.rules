rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Worker profiles
    match /workers/{workerId} {
      allow read: if true; // Public directory for hiring
      allow create: if isAuthenticated() && request.auth.uid == workerId;
      allow update, delete: if isOwner(workerId);
    }

    // Employer profiles
    match /employers/{employerId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == employerId;
      allow update, delete: if isOwner(employerId);
    }

    // Job posts
    match /jobs/{jobId} {
      allow read: if resource.data.isApproved == true || (isAuthenticated() && resource.data.employerId == request.auth.uid);
      allow create: if isAuthenticated()
                    && request.resource.data.dailyWage is int
                    && request.resource.data.dailyWage > 0
                    && request.resource.data.title.size() > 3;
      allow update, delete: if isAuthenticated() && resource.data.employerId == request.auth.uid;
    }

    // Complaints / Reports
    match /complaints/{complaintId} {
      allow create: if true; // Any worker or employer can file a complaint or report fraud
      allow read, update, delete: if false; // Only admin backend can access complaints
    }

    // Saved jobs (Bookmarks)
    match /users/{userId}/saved_jobs/{jobId} {
      allow read, write: if isOwner(userId);
    }
  }
}
